// Prisma schema - Sistema de Deportes Facultad de Ingeniería UNDC

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER_SYSTEM
  ADMIN_SYSTEM
  TREASURER
  REFEREE
  STUDENT
  OTHER
}

enum Gender {
  M
  F
  O
}

enum DisciplineModality {
  TEAM
  INDIVIDUAL
}

enum GenderPolicy {
  MALE
  FEMALE
  MIXED
  FREE
}

enum CompetitionFormat {
  ELIMINATION
  POINTS
}

enum ParticipantType {
  STUDENT
  OTHER
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum VoucherStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum DniProvider {
  DECOLECTA
  APIPERU
}

enum CredentialState {
  UNVERIFIED
  VALID
  INVALID
}

enum PricingMode {
  PER_DISCIPLINE
  PER_GROUP
}

enum GroupScope {
  SECTION
  CYCLE
}

enum VoucherKind {
  TEAM
  BASE
  EXTRA
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  PLAYED
  CANCELLED
  POSTPONED
}

model Faculty {
  id      Int     @id @default(autoincrement())
  name    String
  acronym String?

  schools ProfessionalSchool[]
  events  SportEvent[]
  users   User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalSchool {
  id        Int     @id @default(autoincrement())
  name      String
  facultyId Int
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  events SportEvent[]
  users  User[]
  groups ClassGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  fullName    String
  googleSub   String? @unique
  // scrypt (`scrypt$N$r$p$sal$hash`); nulo = la cuenta solo entra con Google. Nunca sale por la API.
  passwordHash String? @db.VarChar(255)
  // Sube al cambiar o quitar la contraseña: invalida las sesiones emitidas antes (claim `tv` del JWT).
  tokenVersion Int    @default(0)
  avatarUrl   String?
  role        Role    @default(STUDENT)
  isActive    Boolean @default(true)
  studentCode String? @unique
  dni         String?
  facultyId   Int?
  faculty     Faculty? @relation(fields: [facultyId], references: [id])
  schoolId    Int?
  school      ProfessionalSchool? @relation(fields: [schoolId], references: [id])

  delegatedTeams Team[] @relation("TeamDelegate")
  delegatedGroups ClassGroup[] @relation("GroupDelegate")
  participations Participant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SportEvent {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  facultyId   Int
  faculty     Faculty @relation(fields: [facultyId], references: [id])
  schoolId    Int?
  school      ProfessionalSchool? @relation(fields: [schoolId], references: [id])
  startDate   DateTime
  endDate     DateTime
  isOpen      Boolean @default(true)
  pricingMode PricingMode @default(PER_DISCIPLINE)

  disciplines Discipline[]
  apiTokens   EventApiToken[]
  pricing     EventPricing?
  groups      ClassGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Token de integración de un sistema externo (p. ej. el congreso) para un solo
// evento. Solo se guarda el hash HMAC-SHA256 (con API_TOKEN_PEPPER); el valor en
// claro se muestra una única vez al crearlo.
model EventApiToken {
  id          Int        @id @default(autoincrement())
  eventId     Int
  event       SportEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  tokenPrefix String     @unique
  tokenHash   String     @unique
  createdById Int?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model Discipline {
  id                   Int                @id @default(autoincrement())
  eventId              Int
  event                SportEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name                 String
  modality             DisciplineModality @default(TEAM)
  genderPolicy         GenderPolicy       @default(FREE)
  format               CompetitionFormat  @default(ELIMINATION)
  participantType      ParticipantType    @default(STUDENT)
  minPlayers           Int                @default(1)
  maxPlayers           Int                @default(1)
  maxTeams             Int                @default(0)
  isPaid               Boolean            @default(false)
  cost                 Decimal            @default(0) @db.Decimal(10, 2)
  rulesText            String?            @db.Text
  extraInfo            String?            @db.Text
  registrationDeadline DateTime
  winPoints            Int                @default(3)
  drawPoints           Int                @default(1)
  lossPoints           Int                @default(0)
  allowDraw            Boolean            @default(true)
  matchDurationMinutes Int                @default(30)
  courtsCount          Int                @default(1)

  teams     Team[]
  matches   Match[]
  standings Standing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id              Int                @id @default(autoincrement())
  name            String
  disciplineId    Int
  discipline      Discipline         @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  delegateId      Int
  delegate        User               @relation("TeamDelegate", fields: [delegateId], references: [id])
  cycle           String?
  section         String?
  phone           String?
  status          RegistrationStatus @default(PENDING)
  rejectionReason String?            @db.Text
  groupId         Int?
  group           ClassGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  voucherId       Int?
  voucher         Voucher?           @relation("TeamVoucher", fields: [voucherId], references: [id], onDelete: SetNull)
  slot            Int?

  participants  Participant[]
  legacyVoucher Voucher?      @relation("LegacyVoucherTeam")
  homeMatches  Match[]       @relation("HomeTeam")
  awayMatches  Match[]       @relation("AwayTeam")
  wonMatches   Match[]       @relation("WinnerTeam")
  standing     Standing?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, disciplineId, slot])
  @@index([voucherId])
}

model Participant {
  id          Int     @id @default(autoincrement())
  teamId      Int
  team        Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?   @relation(fields: [userId], references: [id])
  fullName    String
  studentCode String?
  dni         String?
  gender      Gender  @default(O)
  isDelegate  Boolean @default(false)
  countsAsPlayer Boolean @default(true)
  isCaptain      Boolean @default(false)

  createdAt DateTime @default(now())
}

model Voucher {
  id              Int           @id @default(autoincrement())
  teamId          Int?          @unique
  team            Team?         @relation("LegacyVoucherTeam", fields: [teamId], references: [id], onDelete: Cascade)
  kind            VoucherKind   @default(TEAM)
  groupId         Int?
  group           ClassGroup?   @relation("GroupVouchers", fields: [groupId], references: [id], onDelete: SetNull)
  baseOfGroup     ClassGroup?   @relation("GroupBaseVoucher")
  teams           Team[]        @relation("TeamVoucher")
  operationNumber String?
  amount          Decimal       @default(0) @db.Decimal(10, 2)
  imageUrl        String
  status          VoucherStatus @default(PENDING)
  rejectionReason String?       @db.Text
  validatedById   Int?

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([groupId, kind])
}

model Match {
  id           Int         @id @default(autoincrement())
  disciplineId Int
  discipline   Discipline  @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  round        Int         @default(1)
  homeTeamId   Int?
  homeTeam     Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId   Int?
  awayTeam     Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int?
  awayScore    Int?
  winnerTeamId Int?
  winnerTeam   Team?       @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  status       MatchStatus @default(PENDING)
  scheduledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Standing {
  id           Int        @id @default(autoincrement())
  disciplineId Int
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  teamId       Int        @unique
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int        @default(0)
  won          Int        @default(0)
  drawn        Int        @default(0)
  lost         Int        @default(0)
  goalsFor     Int        @default(0)
  goalsAgainst Int        @default(0)
  points       Int        @default(0)

  updatedAt DateTime @updatedAt
}

// Tarifas del evento cuando cobra por salón o ciclo (SportEvent.pricingMode = PER_GROUP).
model EventPricing {
  id           Int        @id @default(autoincrement())
  eventId      Int        @unique
  event        SportEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectionBase  Decimal    @default(0) @db.Decimal(10, 2)
  cycleBase    Decimal    @default(0) @db.Decimal(10, 2)
  sectionExtra Decimal    @default(0) @db.Decimal(10, 2)
  cycleExtra   Decimal    @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Salón (ciclo + sección) o ciclo completo que paga: un voucher base cubre un equipo por
// disciplina; cada equipo adicional paga con un voucher EXTRA. section = "" cuando scope = CYCLE
// (un NULL no haría único el índice compuesto en MySQL).
model ClassGroup {
  id            Int                @id @default(autoincrement())
  eventId       Int
  event         SportEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schoolId      Int
  school        ProfessionalSchool @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  scope         GroupScope
  cycle         String
  section       String             @default("")
  delegateId    Int
  delegate      User               @relation("GroupDelegate", fields: [delegateId], references: [id], onDelete: Restrict)
  baseVoucherId Int?               @unique
  baseVoucher   Voucher?           @relation("GroupBaseVoucher", fields: [baseVoucherId], references: [id], onDelete: SetNull)

  teams    Team[]
  vouchers Voucher[] @relation("GroupVouchers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, schoolId, scope, cycle, section])
  @@index([eventId, schoolId, cycle])
}

// Proveedor de consulta de DNI (Decolecta, API Perú) configurable desde la plataforma. El token se
// guarda cifrado con AES-256-GCM (clave de INTEGRATION_SECRET_KEY o derivada de JWT_SECRET) y nunca se
// devuelve por la API. `apiUrl` null = URL oficial del proveedor.
model DniProviderConfig {
  id            Int             @id @default(autoincrement())
  provider      DniProvider     @unique
  enabled       Boolean         @default(true)
  priority      Int             @default(0)
  apiUrl        String?         @db.VarChar(300)
  tokenCipher   String?         @db.Text
  tokenIv       String?
  tokenTag      String?
  tokenLast4    String?
  state         CredentialState @default(UNVERIFIED)
  lastError     String?
  lastCheckedAt DateTime?
  updatedById   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
