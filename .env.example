# Conexión a MariaDB externa (URL completa).
# En desarrollo con BD compartida, limita el pool para no agotar conexiones
# si quedan procesos huérfanos tras `start:dev`:
# DATABASE_URL="mysql://usuario:password@host:3306/deportes_fi?connection_limit=5&pool_timeout=20"
DATABASE_URL="mysql://usuario:password@host:3306/deportes_fi"

# Puerto del servidor
PORT=3001

# Origen(es) permitido(s) para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=cambia-esta-clave-secreta
JWT_EXPIRES_IN=7d

# Pepper del hash HMAC-SHA256 de los tokens de integración por evento (X-Api-Key).
# Obligatorio en producción: sin él, crear o usar tokens responde 503.
# En desarrollo, si falta, se deriva de JWT_SECRET (con advertencia en el log).
# Cambiarlo invalida todos los tokens emitidos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN_PEPPER=

# Google OAuth (mismo Client ID que el frontend)
GOOGLE_CLIENT_ID=

# Dominio institucional principal y dominios permitidos para login

# Endpoint del padrón académico
ACADEMIC_API_URL=https://sivireno.undc.edu.pe/tiger/consulta/con_searchEstudiante.php

# Consulta de DNI (Decolecta / RENIEC)
DECOLECTA_API_URL=https://api.decolecta.com/v1/reniec/dni
DECOLECTA_TOKEN=

# Directorio para archivos subidos (vouchers)
UPLOADS_DIR=uploads

# Cuentas con rol elevado (separadas por coma) - usadas al iniciar sesión
OWNER_EMAILS=
ADMIN_EMAILS=

# Rate limit global de la aplicacion
APP_RATE_LIMIT_WINDOW_MS=60000
APP_RATE_LIMIT_MAX_REQUESTS=120
